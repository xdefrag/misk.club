#!/usr/bin/env python3
"""Афиша встречи Мискатоника: картинка 1080x1080 в стиле сайта.

    tools/afisha ФОТО ДАТА ВРЕМЯ МЕСТО

    tools/afisha ~/Downloads/photo.jpg 26.11.2026 19:00 "ЂЂ"

Делает афишу, кладёт её в docs/afisha.jpg и подставляет дату, время
и место в docs/index.html. Публикация — обычным git commit и git push.

Нужны chromium и ImageMagick (magick).
"""

import argparse
import datetime
import html
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / "tools" / "afisha.html"
SITE_IMAGE = ROOT / "docs" / "afisha.jpg"
SITE_PAGE = ROOT / "docs" / "index.html"

WEEKDAYS = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]


def parse_date(text):
    for fmt in ("%d.%m.%Y", "%Y-%m-%d"):
        try:
            return datetime.datetime.strptime(text, fmt).date()
        except ValueError:
            pass
    sys.exit(f"Не понял дату «{text}». Нужно ДД.ММ.ГГГГ, например 26.11.2026.")


def parse_time(text):
    try:
        return datetime.datetime.strptime(text, "%H:%M").time()
    except ValueError:
        sys.exit(f"Не понял время «{text}». Нужно ЧЧ:ММ, например 19:00.")


def find_browser():
    for name in ("chromium", "chromium-browser", "google-chrome-stable", "google-chrome"):
        path = shutil.which(name)
        if path:
            return path
    sys.exit("Не нашёл chromium: он нужен, чтобы отрисовать афишу.")


def render(photo, title, date, time, place, out):
    if not shutil.which("magick"):
        sys.exit("Не нашёл ImageMagick (команда magick).")

    # Длинное название места набираем мельче, чтобы влезло в свой блок.
    place_size = 76 if len(place) <= 8 else 56 if len(place) <= 16 else 36

    page = TEMPLATE.read_text(encoding="utf-8")
    values = {
        "PHOTO": photo.resolve().as_uri(),
        "TITLE": html.escape(title),
        "DAY": date.strftime("%d.%m"),
        "WEEKDAY": WEEKDAYS[date.weekday()],
        "TIME": time.strftime("%H:%M"),
        "PLACE": html.escape(place),
        "PLACE_SIZE": str(place_size),
    }
    for key, value in values.items():
        page = page.replace("{{" + key + "}}", value)

    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        (tmp / "afisha.html").write_text(page, encoding="utf-8")
        shot = tmp / "afisha.png"
        subprocess.run(
            [
                find_browser(), "--headless", "--disable-gpu", "--hide-scrollbars",
                "--force-device-scale-factor=1", "--window-size=1080,1080",
                "--allow-file-access-from-files",
                f"--screenshot={shot}", (tmp / "afisha.html").as_uri(),
            ],
            check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if not shot.exists():
            sys.exit("Chromium не сделал снимок афиши.")
        subprocess.run(
            ["magick", str(shot), "-crop", "1080x1080+0+0", "+repage",
             "-strip", "-quality", "90", str(out)],
            check=True,
        )


def update_site(date, time, place):
    """Подставляет новую встречу в docs/index.html. Меняет только дату, время и место."""
    page = SITE_PAGE.read_text(encoding="utf-8")
    day = date.strftime("%d.%m")
    full = date.strftime("%d.%m.%Y")
    hhmm = time.strftime("%H:%M")
    weekday = WEEKDAYS[date.weekday()]
    place_html = html.escape(place)

    changes = [
        # крупная дата
        (r'<time datetime="[^"]*">[^<]*</time>',
         f'<time datetime="{date.isoformat()}T{hhmm}">{day}</time>'),
        # строка «четверг, 19:00, в ЂЂ»
        (r'(<p class="time">)[^<]*(</p>)',
         rf'\g<1>{weekday}, {hhmm}, в {place_html}\g<2>'),
        # подпись к картинке
        (r'(<img class="poster"[^>]*?alt=")[^"]*(")',
         rf'\g<1>Афиша: институт Мискатоник, {full}, {hhmm}, в {place_html}\g<2>'),
    ]
    for pattern, replacement in changes:
        page, count = re.subn(pattern, replacement, page, count=1, flags=re.S)
        if count != 1:
            sys.exit(f"Не нашёл в {SITE_PAGE.name} место для подстановки: {pattern}")

    # описания страницы для поисковиков и превью ссылок
    page, count = re.subn(r"\d{2}\.\d{2}\.\d{4}, \d{2}:\d{2}", f"{full}, {hhmm}", page)
    if count == 0:
        sys.exit(f"Не нашёл в {SITE_PAGE.name} дату в описании страницы.")

    SITE_PAGE.write_text(page, encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(
        description="Афиша встречи Мискатоника в стиле сайта, 1080x1080.",
        epilog='Пример: tools/afisha ~/Downloads/photo.jpg 26.11.2026 19:00 "ЂЂ"',
    )
    parser.add_argument("photo", type=pathlib.Path, help="картинка для афиши")
    parser.add_argument("date", help="дата, ДД.ММ.ГГГГ")
    parser.add_argument("time", help="время, ЧЧ:ММ")
    parser.add_argument("place", help="место, как оно пишется после «в»")
    parser.add_argument("--title", default="Новый сезон института",
                        help="строка над названием (по умолчанию «Новый сезон института»)")
    parser.add_argument("--out", type=pathlib.Path,
                        help="куда сохранить вместо docs/afisha.jpg; сайт при этом не трогается")
    args = parser.parse_args()

    if not args.photo.is_file():
        sys.exit(f"Нет такого файла: {args.photo}")
    date = parse_date(args.date)
    time = parse_time(args.time)

    if args.out:
        render(args.photo, args.title, date, time, args.place, args.out)
        print(f"Афиша: {args.out}")
        return

    render(args.photo, args.title, date, time, args.place, SITE_IMAGE)
    update_site(date, time, args.place)
    print(f"Афиша: {SITE_IMAGE}")
    print(f"Сайт:  {SITE_PAGE} — {date.strftime('%d.%m.%Y')}, {WEEKDAYS[date.weekday()]}, "
          f"{time.strftime('%H:%M')}, в {args.place}")
    print("Опубликовать: git add -A && git commit -m 'Новая встреча' && git push")


if __name__ == "__main__":
    main()
